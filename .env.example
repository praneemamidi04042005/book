# Backend
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/bookmyappointment
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d
MAX_UPLOAD_MB=10
DEMO_PASSWORD=

# Optional integrations (app runs in demo mode without these)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Reference ranges are informational and should be configured for local lab,
# age, sex, pregnancy status, and other patient-specific factors.
